        "listStyle": "disc",
        "listItems": [
          {
            "text": "Use the confidential information solely for the stated purpose."
          },
          {
            "text": "Disclose it only to personnel who need it and are bound by equivalent obligations."
          },
          {
            "text": "Protect it with at least the same care used for its own confidential information."
          },
          {
            "text": "Return or destroy it on written request or on termination of this agreement."
