        "type": "TEXT",
        "x": 44,
        "y": 428,
        "width": 507,
        "height": 16,
        "content": "2. Obligations of the receiving party",
        "style": {
          "fontSize": 11,
          "fontFamily": "Inter",
          "color": "#1d4ed8",
          "lineHeight": 1.45,
          "bold": true
