  "variableValues": {
    "metrics": "[{\"metric\":\"Orders dispatched\",\"current\":\"48,210\",\"previous\":\"40,844\",\"change\":\"+18.0%\"},{\"metric\":\"Cost per order\",\"current\":\"₹64.20\",\"previous\":\"₹68.30\",\"change\":\"−6.0%\"},{\"metric\":\"On-time dispatch\",\"current\":\"97.4%\",\"previous\":\"97.6%\",\"change\":\"−0.2pp\"},{\"metric\":\"Order accuracy\",\"current\":\"99.1%\",\"previous\":\"98.7%\",\"change\":\"+0.4pp\"},{\"metric\":\"Returns processed\",\"current\":\"2,118\",\"previous\":\"1,905\",\"change\":\"+11.2%\"}]",
    "report.author": "R. Subramanian",
    "report.number": "OPS-2026-Q2",
    "report.observation_one": "Cost per order improved for the third consecutive quarter, but the rate of improvement is slowing.",
    "report.observation_three": "Returns processing remains the longest single step at an average of 4.2 days.",
    "report.observation_two": "All eleven missed cut-offs in June occurred on days when inbound receipts exceeded 400 units.",
    "report.period": "Apr–Jun 2026",
    "report.recommendations": "Add a second receiving bay before the festive peak, and instrument returns processing so the 4.2-day average can be broken down by cause rather than estimated.",
    "report.status": "Final",
    "report.subtitle": "Fulfilment performance, cost per order and service levels",
    "report.summary": "Order volume grew 18% quarter on quarter while cost per order fell 6%, driven mainly by the consolidation of inbound freight. Service levels held steady, though the dispatch cut-off was missed on eleven occasions in June.",
    "report.title": "Quarterly Operations Review"
  },
